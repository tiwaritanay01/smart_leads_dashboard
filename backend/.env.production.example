# Backend production environment variables
# Copy to backend/.env.production and fill in real values. Do NOT commit secrets.

MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxxx.mongodb.net/smart_leads
JWT_SECRET=<long-random-secret>
JWT_EXPIRES_IN=7d
NODE_ENV=production
PORT=5000
FRONTEND_ORIGIN=https://your-frontend.vercel.app
